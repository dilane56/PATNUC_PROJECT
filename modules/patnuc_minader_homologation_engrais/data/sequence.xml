<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Séquence pour les dossiers d'homologation -->
        <record id="seq_homologation_request" model="ir.sequence">
            <field name="name">Séquence Dossier Homologation</field>
            <field name="code">homologation.request</field>
            <field name="prefix">HOM-%(year)s-</field>
            <field name="padding">5</field>
        </record>

        <!-- Séquence pour les certificats -->
        <record id="seq_homologation_certificate" model="ir.sequence">
            <field name="name">Séquence Certificat Homologation</field>
            <field name="code">homologation.certificate</field>
            <field name="prefix">CERT-%(year)s-</field>
            <field name="padding">5</field>
        </record>

        <!-- Séquence pour les tests -->
        <record id="seq_homologation_test" model="ir.sequence">
            <field name="name">Séquence Test Homologation</field>
            <field name="code">homologation.test</field>
            <field name="prefix">TEST-%(y)s-/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo> 