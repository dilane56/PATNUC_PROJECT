<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue formulaire pour les dossiers d'homologation -->
        <record id="view_homologation_request_form" model="ir.ui.view">
            <field name="name">homologation.request.form</field>
            <field name="model">homologation.request</field>
            <field name="arch" type="xml">
                <form string="Dossier d'homologation">
                    <header>
                        <button name="action_submit_dossier" 
                                string="Soumettre" 
                                type="object" 
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="applicant_id"/>
                                <field name="company_id"/>
                                <field name="product_id"/>
                                <field name="application_type"/>
                            </group>
                            <group>
                                <field name="stage_id"/>
                                <field name="submission_date"/>
                                <field name="approval_date"/>
                                <field name="expiry_date"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="fees_paid"/>
                                <field name="samples_deposited"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Documents">
                                <field name="document_ids"/>
                            </page>
                            <page string="Tests">
                                <field name="test_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vue liste pour les dossiers d'homologation -->
        <record id="view_homologation_request_tree" model="ir.ui.view">
            <field name="name">homologation.request.tree</field>
            <field name="model">homologation.request</field>
            <field name="arch" type="xml">
                <tree string="Dossiers d'homologation">
                    <field name="name"/>
                    <field name="applicant_id"/>
                    <field name="company_id"/>
                    <field name="product_id"/>
                    <field name="stage_id"/>
                    <field name="submission_date"/>
                    <field name="fees_paid"/>
                    <field name="samples_deposited"/>
                </tree>
            </field>
        </record>

        <!-- Vue kanban pour les dossiers d'homologation -->
        <record id="view_homologation_request_kanban" model="ir.ui.view">
            <field name="name">homologation.request.kanban</field>
            <field name="model">homologation.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="applicant_id"/>
                    <field name="company_id"/>
                    <field name="product_id"/>
                    <field name="stage_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="applicant_id"/>
                                        <field name="company_id"/>
                                        <field name="product_id"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action pour les dossiers d'homologation -->
        <record id="action_homologation_request" model="ir.actions.act_window">
            <field name="name">Dossiers d'homologation</field>
            <field name="res_model">homologation.request</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_my_requests': 1}</field>
        </record>
    </data>
</odoo>

