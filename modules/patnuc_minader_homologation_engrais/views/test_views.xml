<!-- Nouveau fichier sans préfixe fertilizer -->
<odoo>
    <record id="view_test_tree" model="ir.ui.view">
        <field name="name">test.tree</field>
        <field name="model">test</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="test_type"/>
                <field name="laboratory_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="result"/>
            </tree>
        </field>
    </record>

    <record id="view_test_form" model="ir.ui.view">
        <field name="name">test.form</field>
        <field name="model">test</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="test_type"/>
                        <field name="laboratory_id"/>
                        <field name="state"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="result"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
