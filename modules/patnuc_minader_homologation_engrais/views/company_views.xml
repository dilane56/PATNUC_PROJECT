<!-- Nouveau fichier sans préfixe fertilizer -->
<odoo>
    <record id="view_company_tree" model="ir.ui.view">
        <field name="name">company.tree</field>
        <field name="model">company</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="company_type"/>
                <field name="legal_form"/>
                <field name="country_id"/>
                <field name="contact_person"/>
                <field name="contact_email"/>
                <field name="contact_phone"/>
            </tree>
        </field>
    </record>

    <record id="view_company_form" model="ir.ui.view">
        <field name="name">company.form</field>
        <field name="model">company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'entreprise"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_type"/>
                            <field name="legal_form"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="registration_number"/>
                            <field name="tax_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="contact_person"/>
                            <field name="contact_phone"/>
                            <field name="contact_email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Adresse">
                            <group>
                                <field name="address" nolabel="1"/>
                                <field name="city"/>
                            </group>
                        </page>
                        <page string="Documents légaux">
                            <group>
                                <field name="registration_certificate" filename="registration_certificate_filename"/>
                                <field name="registration_certificate_filename" invisible="1"/>
                                <field name="tax_certificate" filename="tax_certificate_filename"/>
                                <field name="tax_certificate_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Autorisations spéciales">
                            <group>
                                <field name="import_license" filename="import_license_filename" invisible="company_type != 'importer'"/>
                                <field name="import_license_filename" invisible="1"/>
                                <field name="manufacturing_license" filename="manufacturing_license_filename" invisible="company_type != 'manufacturer'"/>
                                <field name="manufacturing_license_filename" invisible="1"/>
                                <field name="research_authorization" filename="research_authorization_filename" invisible="company_type not in ('research_institute', 'university')"/>
                                <field name="research_authorization_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Dossiers d'homologation">
                            <field name="homologation_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="applicant_id"/>
                                    <field name="product_id"/>
                                    <field name="stage_id"/>
                                    <field name="submission_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_company_search" model="ir.ui.view">
        <field name="name">company.search</field>
        <field name="model">company</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="contact_person"/>
                <field name="contact_email"/>
                <filter string="Fabricants" name="manufacturers" domain="[('company_type', '=', 'manufacturer')]"/>
                <filter string="Importateurs" name="importers" domain="[('company_type', '=', 'importer')]"/>
                <filter string="Distributeurs" name="distributors" domain="[('company_type', '=', 'distributor')]"/>
                <filter string="Instituts de recherche" name="research_institutes" domain="[('company_type', 'in', ['research_institute', 'university'])]"/>
                <filter string="Coopératives" name="cooperatives" domain="[('company_type', '=', 'cooperative')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type d'entreprise" name="group_type" context="{'group_by': 'company_type'}"/>
                    <filter string="Pays" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="Forme juridique" name="group_legal_form" context="{'group_by': 'legal_form'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_company" model="ir.actions.act_window">
        <field name="res_model">company</field>
        <field name="name">Entreprises</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_manufacturers': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première entreprise productrice d'engrais
            </p>
            <p>
                Les entreprises peuvent être des fabricants, importateurs, distributeurs, laboratoires, coopératives ou instituts de recherche.
            </p>
        </field>
    </record>
</odoo>
