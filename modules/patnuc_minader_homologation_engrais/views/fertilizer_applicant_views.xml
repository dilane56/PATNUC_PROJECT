<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue formulaire pour les demandeurs -->
        <record id="view_homologation_applicant_form" model="ir.ui.view">
            <field name="name">homologation.applicant.form</field>
            <field name="model">homologation.applicant</field>
            <field name="arch" type="xml">
                <form string="Demandeur">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="identification_number"/>
                                <field name="applicant_type"/>
                                <field name="nationality"/>
                            </group>
                            <group>
                                <field name="email"/>
                                <field name="company_name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vue liste pour les demandeurs -->
        <record id="view_homologation_applicant_tree" model="ir.ui.view">
            <field name="name">homologation.applicant.tree</field>
            <field name="model">homologation.applicant</field>
            <field name="arch" type="xml">
                <tree string="Demandeurs">
                    <field name="name"/>
                    <field name="applicant_type"/>
                    <field name="email"/>
                    <field name="company_name"/>
                </tree>
            </field>
        </record>

        <!-- Action pour les demandeurs -->
        <record id="action_homologation_applicant" model="ir.actions.act_window">
            <field name="name">Demandeurs</field>
            <field name="res_model">homologation.applicant</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>


