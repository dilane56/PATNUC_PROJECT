<!-- Nouveau fichier sans préfixe fertilizer -->
<odoo>
    <record id="view_stage_tree" model="ir.ui.view">
        <field name="name">stage.tree</field>
        <field name="model">stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="sequence"/>
                <field name="is_final"/>
            </tree>
        </field>
    </record>

    <record id="view_stage_form" model="ir.ui.view">
        <field name="name">stage.form</field>
        <field name="model">stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="is_final"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
