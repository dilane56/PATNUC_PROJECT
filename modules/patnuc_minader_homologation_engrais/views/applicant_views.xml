<!-- Nouveau fichier sans préfixe fertilizer -->
<odoo>
    <record id="view_applicant_tree" model="ir.ui.view">
        <field name="name">applicant.tree</field>
        <field name="model">applicant</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="identification_number"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="applicant_type"/>
                <field name="nationality"/>
            </tree>
        </field>
    </record>

    <record id="view_applicant_form" model="ir.ui.view">
        <field name="name">applicant.form</field>
        <field name="model">applicant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="identification_number"/>
                        <field name="company_name"/>
                        <field name="email"/>
                        <field name="applicant_type"/>
                        <field name="nationality"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_applicant_search" model="ir.ui.view">
        <field name="name">applicant.search</field>
        <field name="model">applicant</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="identification_number"/>
                <field name="company_name"/>
                <field name="email"/>
                <filter string="Entreprises privées" name="private_companies" domain="[('applicant_type', 'in', ['private_company', 'manufacturer', 'importer'])]"/>
                <filter string="Instituts de recherche" name="research_institutes" domain="[('applicant_type', 'in', ['research_institute', 'university'])]"/>
                <filter string="Coopératives" name="cooperatives" domain="[('applicant_type', '=', 'cooperative')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type de demandeur" name="group_type" context="{'group_by': 'applicant_type'}"/>
                    <filter string="Nationalité" name="group_nationality" context="{'group_by': 'nationality'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_applicant" model="ir.actions.act_window">
        <field name="res_model">applicant</field>
        <field name="name">Demandeurs</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_private_companies': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier demandeur d'homologation
            </p>
            <p>
                Les demandeurs peuvent être des entreprises privées, fabricants, importateurs, instituts de recherche, universités ou coopératives.
            </p>
        </field>
    </record>
</odoo>
