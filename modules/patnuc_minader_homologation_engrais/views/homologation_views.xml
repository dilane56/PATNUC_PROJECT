<!-- Nouveau fichier sans préfixe fertilizer -->
<odoo>
    <record id="view_homologation_request_kanban" model="ir.ui.view">
        <field name="name">homologation.request.kanban</field>
        <field name="model">homologation.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="applicant_id"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <field name="stage_id"/>
                <field name="submission_date"/>
                <field name="fees_paid"/>
                <field name="samples_deposited"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><strong>Demandeur:</strong> <field name="applicant_id"/></div>
                                    <div><strong>Entreprise:</strong> <field name="company_id"/></div>
                                    <div><strong>Produit:</strong> <field name="product_id"/></div>
                                    <div><strong>Date:</strong> <field name="submission_date"/></div>
                                    <div t-if="fees_paid" class="badge badge-success">Frais payés</div>
                                    <div t-if="samples_deposited" class="badge badge-info">Échantillons déposés</div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_homologation_request_tree" model="ir.ui.view">
        <field name="name">homologation.request.tree</field>
        <field name="model">homologation.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="applicant_id"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <field name="application_type"/>
                <field name="stage_id"/>
                <field name="submission_date"/>
                <field name="approval_date"/>
                <field name="expiry_date"/>
                <field name="fees_paid" widget="boolean_toggle"/>
                <field name="samples_deposited" widget="boolean_toggle"/>
                <field name="is_expired" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_homologation_request_form" model="ir.ui.view">
        <field name="name">homologation.request.form</field>
        <field name="model">homologation.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_dossier" string="Soumettre" type="object" class="btn-primary" invisible="stage_id.name != 'Brouillon'"/>
                    <button name="action_start_conformity_check" string="Démarrer contrôle conformité" type="object" class="oe_highlight" invisible="stage_id.name != 'Soumis'"/>
                    <button name="action_start_chemical_analysis" string="Démarrer analyses chimiques" type="object" class="oe_highlight" invisible="stage_id.name != 'Contrôle de conformité'"/>
                    <button name="action_start_biological_test" string="Démarrer tests biologiques" type="object" class="oe_highlight" invisible="stage_id.name != 'Analyses chimiques'"/>
                    <button name="action_start_prevulgarization" string="Démarrer prévulgarisation" type="object" class="oe_highlight" invisible="stage_id.name != 'Tests d'efficacité biologique'"/>
                    <button name="action_start_agro_economic" string="Démarrer évaluation agro-économique" type="object" class="oe_highlight" invisible="stage_id.name != 'Tests de prévulgarisation'"/>
                    <button name="action_approve_homologation" string="Approuver homologation" type="object" class="oe_highlight" invisible="stage_id.name != 'Évaluation agro-économique'"/>
                    <button name="action_reject_homologation" string="Rejeter" type="object" invisible="stage_id.name in ('Homologué', 'Rejeté')"/>
                    <button name="action_request_additional_info" string="Demander infos complémentaires" type="object" invisible="stage_id.name in ('Homologué', 'Rejeté', 'Brouillon')"/>
                    <button name="action_reset_to_draft" string="Remettre en brouillon" type="object" invisible="stage_id.name not in ('Soumis', 'Rejeté')"/>
                    <field name="stage_id" widget="statusbar" statusbar_visible="Brouillon,Soumis,Contrôle de conformité,Analyses chimiques,Tests d'efficacité biologique,Tests de prévulgarisation,Évaluation agro-économique,Homologué,Rejeté"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="applicant_id"/>
                            <field name="company_id"/>
                            <field name="product_id"/>
                            <field name="application_type"/>
                        </group>
                        <group>
                            <field name="submission_date"/>
                            <field name="total_days"/>
                            <field name="fees_paid"/>
                            <field name="samples_deposited"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="conformity_agent_id"/>
                            <field name="evaluation_agent_id"/>
                            <field name="final_approver_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <group>
                                <field name="fees_amount"/>
                                <field name="payment_proof" filename="payment_proof_filename"/>
                                <field name="payment_proof_filename" invisible="1"/>
                                <field name="samples_quantity"/>
                                <field name="samples_receipt" filename="samples_receipt_filename"/>
                                <field name="samples_receipt_filename" invisible="1"/>
                            </group>
                            <field name="document_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="filename"/>
                                    <field name="file_size"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tests">
                            <field name="test_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="test_type"/>
                                    <field name="laboratory_id"/>
                                    <field name="state"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="result"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Dates importantes">
                            <group>
                                <group>
                                    <field name="conformity_check_date"/>
                                    <field name="chemical_analysis_date"/>
                                    <field name="biological_test_date"/>
                                </group>
                                <group>
                                    <field name="prevulgarization_date"/>
                                    <field name="agro_economic_date"/>
                                    <field name="approval_date"/>
                                    <field name="expiry_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Évaluation" invisible="stage_id.name in ('Brouillon', 'Soumis')">
                            <group>
                                <field name="conformity_notes" nolabel="1" placeholder="Notes du contrôle de conformité"/>
                            </group>
                            <group>
                                <field name="evaluation_notes" nolabel="1" placeholder="Notes d'évaluation générale"/>
                            </group>
                            <field name="rejection_reason" invisible="stage_id.name != 'Rejeté'" nolabel="1" placeholder="Motif de rejet"/>
                        </page>
                        <page string="Certificat" invisible="stage_id.name != 'Homologué'">
                            <group>
                                <field name="certificate_number"/>
                                <field name="certificate_file" filename="certificate_filename"/>
                                <field name="certificate_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_homologation_request" model="ir.actions.act_window">
        <field name="res_model">homologation.request</field>
        <field name="name">Dossiers d'homologation</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier dossier d'homologation
            </p>
            <p>
                Le processus d'homologation comprend 7 étapes principales selon la procédure officielle MINADER.
            </p>
        </field>
    </record>
</odoo>
