<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue formulaire pour les produits -->
        <record id="view_homologation_product_form" model="ir.ui.view">
            <field name="name">homologation.product.form</field>
            <field name="model">homologation.product</field>
            <field name="arch" type="xml">
                <form string="Produit">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="manufacturer"/>
                            </group>
                            <group>
                                <field name="composition"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vue liste pour les produits -->
        <record id="view_homologation_product_tree" model="ir.ui.view">
            <field name="name">homologation.product.tree</field>
            <field name="model">homologation.product</field>
            <field name="arch" type="xml">
                <tree string="Produits">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="manufacturer"/>
                </tree>
            </field>
        </record>

        <!-- Action pour les produits -->
        <record id="action_homologation_product" model="ir.actions.act_window">
            <field name="name">Produits</field>
            <field name="res_model">homologation.product</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>


