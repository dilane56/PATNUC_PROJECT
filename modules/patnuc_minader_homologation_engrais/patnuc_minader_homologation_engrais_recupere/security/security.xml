<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Groupe de sécurité pour les homologations -->
        <record id="group_fertilizer_user" model="res.groups">
            <field name="name">Utilisateur Homologation</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_fertilizer_manager" model="res.groups">
            <field name="name">Gestionnaire Homologation</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_fertilizer_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_fertilizer_reviewer" model="res.groups">
            <field name="name">Évaluateur Homologation</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_fertilizer_user'))]"/>
        </record>

        <record id="group_fertilizer_conformity_agent" model="res.groups">
            <field name="name">Agent Contrôle Conformité</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_fertilizer_user'))]"/>
        </record>

        <record id="group_fertilizer_final_approver" model="res.groups">
            <field name="name">Approbateur Final</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_fertilizer_reviewer'))]"/>
        </record>
    </data>
</odoo> 