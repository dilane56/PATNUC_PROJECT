<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Séquence pour les dossiers d'homologation -->
        <record id="seq_fertilizer_homologation" model="ir.sequence">
            <field name="name">Séquence Dossier Homologation</field>
            <field name="code">fertilizer.homologation</field>
            <field name="prefix">HOM-%(year)s-</field>
            <field name="padding">5</field>
        </record>

        <!-- Séquence pour les certificats -->
        <record id="seq_fertilizer_certificate" model="ir.sequence">
            <field name="name">Séquence Certificat Homologation</field>
            <field name="code">fertilizer.certificate</field>
            <field name="prefix">CERT-%(year)s-</field>
            <field name="padding">5</field>
        </record>

        <!-- Séquence pour les tests -->
        <record id="seq_fertilizer_test" model="ir.sequence">
            <field name="name">Séquence Test Homologation</field>
            <field name="code">fertilizer.test</field>
            <field name="prefix">TEST-%(y)s-/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo> 