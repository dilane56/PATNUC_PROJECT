<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Étapes du workflow d'homologation -->
        
        <!-- Étape 1: Brouillon -->
        <record id="stage_draft" model="fertilizer.stage">
            <field name="name">Brouillon</field>
            <field name="sequence">1</field>
            <field name="description">Dossier en cours de préparation</field>
            <field name="color">1</field>
        </record>
        
        <!-- Étape 2: Soumis -->
        <record id="stage_submitted" model="fertilizer.stage">
            <field name="name">Soumis</field>
            <field name="sequence">2</field>
            <field name="description">Dossier soumis pour contrôle de conformité</field>
            <field name="color">2</field>
        </record>
        
        <!-- Étape 3: Contrôle de conformité -->
        <record id="stage_conformity_check" model="fertilizer.stage">
            <field name="name">Contrôle de conformité</field>
            <field name="sequence">3</field>
            <field name="description">Vérification de la conformité du dossier et des échantillons</field>
            <field name="color">3</field>
        </record>
        
        <!-- Étape 4: Analyses chimiques -->
        <record id="stage_chemical_analysis" model="fertilizer.stage">
            <field name="name">Analyses chimiques</field>
            <field name="sequence">4</field>
            <field name="description">Analyses chimiques par laboratoire agréé</field>
            <field name="color">4</field>
        </record>
        
        <!-- Étape 5: Tests d'efficacité biologique -->
        <record id="stage_biological_test" model="fertilizer.stage">
            <field name="name">Tests d'efficacité biologique</field>
            <field name="sequence">5</field>
            <field name="description">Tests d'efficacité sur un ou deux cycles agricoles</field>
            <field name="color">5</field>
        </record>
        
        <!-- Étape 6: Tests de prévulgarisation -->
        <record id="stage_prevulgarization" model="fertilizer.stage">
            <field name="name">Tests de prévulgarisation</field>
            <field name="sequence">6</field>
            <field name="description">Tests par les services de protection des végétaux</field>
            <field name="color">6</field>
        </record>
        
        <!-- Étape 7: Évaluation agro-économique -->
        <record id="stage_agro_economic" model="fertilizer.stage">
            <field name="name">Évaluation agro-économique</field>
            <field name="sequence">7</field>
            <field name="description">Évaluation de la performance agro-économique</field>
            <field name="color">7</field>
        </record>
        
        <!-- Étape 8: Homologué -->
        <record id="stage_approved" model="fertilizer.stage">
            <field name="name">Homologué</field>
            <field name="sequence">8</field>
            <field name="description">Produit homologué et autorisé à la commercialisation</field>
            <field name="color">10</field>
        </record>
        
        <!-- Étape 9: Rejeté -->
        <record id="stage_rejected" model="fertilizer.stage">
            <field name="name">Rejeté</field>
            <field name="sequence">9</field>
            <field name="description">Dossier rejeté</field>
            <field name="color">1</field>
        </record>
        
    </data>
</odoo> 