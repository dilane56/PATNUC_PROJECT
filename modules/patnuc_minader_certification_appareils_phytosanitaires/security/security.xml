<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="category_phytosanitary" model="ir.module.category">
            <field name="name">Certification des appareils phytosanitaires</field>
            <field name="description">Gestion des certifications des appareils phytosanitaires</field>
        </record>

        <!-- Groupes d'utilisateurs -->
        <record id="group_phytosanitary_user" model="res.groups">
            <field name="name">Utilisateur Certification Phytosanitaire</field>
            <field name="category_id" ref="category_phytosanitary"/>
        </record>

        <record id="group_phytosanitary_agent" model="res.groups">
            <field name="name">Agent DRIPA</field>
            <field name="category_id" ref="category_phytosanitary"/>
            <field name="implied_ids" eval="[(4, ref('group_phytosanitary_user'))]"/>
        </record>

        <record id="group_phytosanitary_validator" model="res.groups">
            <field name="name">Validateur DRIPA</field>
            <field name="category_id" ref="category_phytosanitary"/>
            <field name="implied_ids" eval="[(4, ref('group_phytosanitary_agent'))]"/>
        </record>

        <record id="group_phytosanitary_manager" model="res.groups">
            <field name="name">Gestionnaire Certification</field>
            <field name="category_id" ref="category_phytosanitary"/>
            <field name="implied_ids" eval="[(4, ref('group_phytosanitary_validator'))]"/>
        </record>

