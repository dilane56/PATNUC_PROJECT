<odoo>
    <data>
        <record id="certification_appareil_form_view" model="ir.ui.view">
            <field name="name">certification.appareil.form</field>
            <field name="model">certification.appareil</field>
            <field name="arch" type="xml">
                <form string="Appareil de traitement phytosanitaire">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Nom de l'appareil"/>
                            <h1><field name="name" placeholder="Nom de l'appareil"/></h1>
                        </div>
                        <group>
                            <group string="Informations Générales">
                                <field name="marque"/>
                                <field name="model"/>
                                <field name="type_appareil"/>
                            </group>
                            <group string="Spécifications Techniques">
                                <field name="energy_source"/>
                                <field name="capacity"/>
                                <field name="max_pressure"/>
                                <field name="flow_rate"/>
                                <field name="manufacture_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="certification_appareil_tree_view" model="ir.ui.view">
            <field name="name">certification.appareil.tree</field>
            <field name="model">certification.appareil</field>
            <field name="arch" type="xml">
                <tree string="Appareils de traitement phytosanitaire">
                    <field name="name"/>
                    <field name="marque"/>
                    <field name="type_appareil"/>
                    <field name="capacity"/>
                    <field name="energy_source"/>
                </tree>
            </field>
        </record>

        <record id="certification_appareil_action" model="ir.actions.act_window">
            <field name="name">Appareils Phytosanitaires</field>
            <field name="res_model">certification.appareil</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_appareil_root" name="Appareils" parent="menu_certification_root" sequence="20"/>
        <menuitem id="menu_appareil_list" name="Liste des Appareils" parent="menu_appareil_root" action="certification_appareil_action" sequence="10"/>

    </data>
</odoo>