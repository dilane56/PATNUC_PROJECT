<odoo>
    <data>
        <record id="seq_laissez_passer" model="ir.sequence">
            <field name="name">Laissez-passer Sanitaire</field>
            <field name="code">laissez.passer</field>
            <field name="prefix">LPS-%(year)s-</field>
            <field name="padding">4</field>
        </record>

        <record id="laissez_passer_form_view" model="ir.ui.view">
            <field name="name">laissez.passer.form</field>
            <field name="model">laissez.passer</field>
            <field name="arch" type="xml">
                <form string="Laissez-passer Sanitaire">
                    <header>
                        <button name="action_submit" type="object" string="Soumettre" invisible="state != 'draft'"  class="oe_highlight"/>
                        <button name="action_admin_check_ok" type="object" string="Lancer la vérification approfondie" invisible="state !='administrative_control'" groups="patnuc_minepia_laisser_passer_sanitaire.group_agent_service_veterinaire_lp" class="oe_highlight" readonly="[('can_validate_admin', '=', False)]"/>
                        <button name="action_deeper_check_ok" type="object" string="Approuver le laissez-passer" invisible="state != 'deeper_check' or deeper_check_result != 'favorable'" groups="patnuc_minepia_laisser_passer_sanitaire.group_agent_service_veterinaire_lp" class="oe_highlight"/>
                        <button name="%(patnuc_minepia_laisser_passer_sanitaire.action_laissez_passer_rejet_wizard)d"
                                    string="Rejeter"
                                    type="action"
                                   invisible="state in ('draft','rejected','approved')  "/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,administrative_control,deeper_check,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="initiateur_id" readonly="state != 'draft'"/>
                                <field name="date_demande"/>
                            </group>
                            <group>
                                <field name="type_demande" readonly="state != 'draft'"/>
                                <field name="delai_imparti" invisible="state=='draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Pièces à fournir">
                                <group>
                                    <field name="declaration_denree" readonly="state != 'draft'"/>
                                    <field name="certificat_sanitaire" readonly="state != 'draft'"/>
                                    <field name="photocopie_cni" readonly="state != 'draft'"/>
                                    <field name="recu_paiement" readonly="state != 'draft'"/>
                                </group>
                            </page>

                            <page string="Vérification administrative"
                                  invisible="state =='draft'" groups="patnuc_minepia_laisser_passer_sanitaire.group_agent_service_veterinaire_lp">
                                <group>
                                    <group>
                                        <field name="declaration_ok" readonly="state != 'administrative_control'"/>
                                        <field name="certificat_sanitaire_ok" readonly="state != 'administrative_control'"/>
                                        <field name="cni_ok" readonly="state != 'administrative_control'"/>
                                        <field name="recu_paiement_ok" readonly="state != 'administrative_control'"/>
                                    </group>
                                    <group>
                                        <field name="administrative_check_date" readonly="1"/>
                                        <field name="administrative_checker_id" readonly="1"/>
                                    </group>
                                </group>
                                <field name="administrative_check_comment"  readonly="state != 'administrative_control'"/>
                            </page>

                            <page string="Vérification Approfondie" invisible="state in ('draft','administrative_control')" groups="patnuc_minepia_laisser_passer_sanitaire.group_agent_service_veterinaire_lp">

                                    <group>
                                        <field name="deeper_check_result" readonly="state != 'deeper_check'"/>
                                    </group>
                                    <group string="information supplementaire sur la verification">
                                        <field name="deeper_checker_id" readonly="1"/>
                                        <field name="deeper_check_date" readonly="1"/>
                                    </group>

                            </page>

                            <page string="Details du rejet" invisible="state != 'rejected'">
                                <group>
                                    <field name="rejection_reason" readonly="1"/>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="laissez_passer_tree_view" model="ir.ui.view">
            <field name="name">laissez.passer.tree</field>
            <field name="model">laissez.passer</field>
            <field name="arch" type="xml">
                <tree string="Demandes de Laissez-passer">
                    <field name="name"/>
                    <field name="initiateur_id"/>
                    <field name="date_demande"/>
                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                </tree>
            </field>
        </record>

        <record id="laissez_passer_action" model="ir.actions.act_window">
            <field name="name">Laissez-passers Sanitaires</field>
            <field name="res_model">laissez.passer</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_laissez_passer_root" name="Laissez-passers Sanitaires" sequence="40"/>
        <menuitem id="menu_laissez_passer_requests" name="Demandes de Laissez-passer" parent="menu_laissez_passer_root" action="laissez_passer_action" sequence="10"/>
    </data>
</odoo>