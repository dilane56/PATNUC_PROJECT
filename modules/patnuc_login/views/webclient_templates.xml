<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="login_layout" inherit_id="web.login_layout" name="Login Layout Inherit">
		<xpath expr="//div[@class='container py-5']" position="replace">
			<div class="contain">
				<div id="background-wrapper">
				</div>
				<div class="card-login">
					<div style="position:relative; bottom:-25px"
						t-attf-class="text-center pb-2">
						<h1>PATNUC</h1>
						<p style="font-size:20px">Projet d'accélération de la transformation numérique au Cameroun</p>
						<p style="font-size:13px"> <strong> V : 1.0 </strong></p>
					</div>
					<div class="card-body-login">
						<div
							t-attf-class="text-center pb-2 {{'mb-1' if form_small else 'mb-2'}}">
							<img id="logo"
								t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
								alt="Logo" />
						</div>
						<div
							t-attf-class="text-center pb-2  {{'mb-2' if form_small else 'mb-3'}}">
							<h5>Se Connecter</h5>
						</div>
						<t t-out="0" />
					</div>

				</div>
			</div>
		</xpath>
	</template>

	<template id="login" inherit_id="web.login" name="Login Inherit">
		<xpath expr="//label[@for='db']" position="replace" />
		<xpath expr="//label[@for='login']" position="replace" />
		<xpath expr="//label[@for='password']" position="replace" />

		<xpath expr="//input[@name='login']" position="attributes">
			<attribute name="placeholder">Identifiant ...</attribute>
			<attribute name="autocomplete">off</attribute>
			<attribute name="autocorrect">off</attribute>
		</xpath>

		<xpath expr="//input[@name='password']" position="attributes">
			<attribute name="placeholder">Mot de passe ...</attribute>
		</xpath>

		<xpath expr="//button[@type='submit']" position="replace">
			<a href="/web/reset_password?">Mot de passe oublié?</a>
			<button type="submit" class="btn">Connexion</button>
		</xpath>

		<xpath expr="//input[@id='db']" position="replace" />
		<xpath expr="//button[@name='redirect']" position="replace" />
	</template>
	<!-- <template id="login_footer" inherit_id="web.login_footer" name="Login Footer">
		<xpath expr="//div[@class='justify-content-between mt-2 d-flex small']" position="replace"/>
	</template> -->

</odoo>