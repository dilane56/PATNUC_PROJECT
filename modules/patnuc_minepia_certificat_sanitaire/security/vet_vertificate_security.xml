<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Définition d'une nouvelle catégorie pour nos groupes -->
    <record id="module_category_procedures_minepia" model="ir.module.category">
        <field name="name">Service Régional des services vétérinaire</field>
        <field name="description">Groupes liés aux agents qui gerent la procedure d'obtention d'un certificat sanitaire</field>
        <field name="sequence">10</field>
    </record>

    <!-- Groupe Agent du minepia -->
    <record id="group_agent_service_veterinaire" model="res.groups">
        <field name="name">Agent des Services Vétérinaires</field>
        <field name="category_id" ref="module_category_procedures_minepia"/>
    </record>

        <record id="group_delegue_regional_csv" model="res.groups">
            <field name="name">Délegué Régionale</field>
            <field name="category_id" ref="module_category_procedures_minepia"/>
        </record>



</odoo>
