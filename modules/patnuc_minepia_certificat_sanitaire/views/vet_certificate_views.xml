<odoo>
    <data>
        <record id="seq_vet_certificate" model="ir.sequence">
            <field name="name">Certificat Sanitaire Vétérinaire</field>
            <field name="code">vet.certificate</field>
            <field name="prefix">CSV-%(year)s-</field>
            <field name="padding">4</field>
        </record>

        <record id="vet_certificate_form_view" model="ir.ui.view">
            <field name="name">vet.certificate.form</field>
            <field name="model">vet.certificate</field>
            <field name="arch" type="xml">
                <form string="Certificat Sanitaire Vétérinaire">
                    <header>
                        <button name="action_submit" type="object" string="Soumettre" invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="action_technical_inspection" type="object" string="Valider la vérification et Lancer l'inspection sanitaire" invisible="state !='administrative_control'" groups="patnuc_minepia_certificat_sanitaire.group_agent_service_veterinaire" class="oe_highlight" readonly="[('can_validate_admin', '=', False)]"/>
                        <button name="action_regulatory_approval" type="object" string="Lancer l'approbation" invisible="state != 'technical_inspection'" class="oe_highlight"/>
                        <button name="action_approve" type="object" string="Approuver le certificat" invisible="state != 'regulatory_approval'" class="oe_highlight"/>
                        <button name="%(action_vet_rejet_wizard)d"
                                    string="Rejeter"
                                    type="action"
                                    invisible="state in ('draft', 'rejected', '')" />

                        <field name="state" widget="statusbar" statusbar_visible="draft,administrative_control,technical_inspection,regulatory_approval,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="initiateur_id" readonly="state != 'draft'"/>
                                <field name="date_demande"/>
                            </group>
                            <group>
                                <field name="type_demande" readonly="state != 'draft'"/>
                                  <field name="delai_imparti" invisible="state=='draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Pièces à fournir">
                                <group>
                                    <field name="declaration_denrees" readonly="state != 'draft'"/>
                                    <field name="photocopie_cni" readonly="state != 'draft'"/>
                                    <field name="recu_paiement" readonly="state != 'draft'"/>
                                    <field name="carnet_vaccination" invisible="type_demande != 'animaux'" readonly="state != 'draft'"/>

                                </group>
                            </page>
                            <page string="Verification administrative" invisible="state =='draft'" groups="patnuc_minepia_certificat_sanitaire.group_agent_service_veterinaire">
                                <group>
                                    <group>
                                         <field name="declaration_ok"/>
                                        <field name="certificat_sanitaire_ok"/>
                                        <field name="cni_ok"/>
                                        <field name="recu_paiement_ok"/>
                                    </group>
                                    <group>
                                        <field name="administrative_check_date" readonly="1"/>
                                        <field name="administrative_checker_id" readonly="1"/>
                                    </group>

                                </group>
                                <field name="administrative_check_comment" placeholder="Ajouter des commentaires sur la vérification..."/>

                            </page>
                            <page string="Details du rejet" invisible="state != 'rejected'">
                                <group>
                                    <field name="rejection_reason" readonly="1"/>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="vet_certificate_tree_view" model="ir.ui.view">
            <field name="name">vet.certificate.tree</field>
            <field name="model">vet.certificate</field>
            <field name="arch" type="xml">
                <tree string="Demandes de Certificat Vétérinaire">
                    <field name="name"/>
                    <field name="initiateur_id"/>
                    <field name="date_demande"/>
                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                </tree>
            </field>
        </record>

        <record id="vet_certificate_action" model="ir.actions.act_window">
            <field name="name">Certificats Vétérinaires</field>
            <field name="res_model">vet.certificate</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_vet_certificate_root" name="Certificats Vétérinaires" sequence="30"/>
        <menuitem id="menu_vet_certificate_requests" name="Demandes de Certificat" parent="menu_vet_certificate_root" action="vet_certificate_action" sequence="10"/>
    </data>
</odoo>